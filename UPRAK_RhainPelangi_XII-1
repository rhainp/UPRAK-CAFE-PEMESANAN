def pesan_menu():
    os.system("clear")

    print("\n===== PESAN MENU =====")

    nama_pelanggan_pelangi= input("Masukkan nama anda: ")

    # Cek apakah pelanggan terdaftar
    sql = """
    SELECT id_pelanggan_pelangi, nama_pelanggan_pelangi
    FROM pelanggan_pelangi
    WHERE nama_pelanggan_pelangi = %s
    """
    cursor.execute(sql, (nama_pelanggan_pelangi,))
    pelanggan = cursor.fetchone()

    if pelanggan is None:
        print("Pelanggan tidak ditemukan!")
        input("\nTekan Enter untuk kembali...")
        return

    id_pelanggan_pelangi = pelanggan[0]
    daftar_pesanan = []
    total_harga = 0

    while True:
        tampil_menu()

        nama_menu_pelangi = input("\nMasukkan nama menu: ")

        # Mencari menu tanpa memperhatikan huruf besar/kecil
        sql = """
        SELECT id_menu_pelangi, nama_menu_pelangi, harga_pelangi, stok_pelangi
        FROM menucafe_pelangi
        WHERE LOWER(nama_menu_pelangi) LIKE LOWER(%s)
        """

        cursor.execute(sql, ("%" + nama_menu_pelangi + "%",))
        hasil = cursor.fetchall()

        if len(hasil) == 0:
            print("Menu tidak ditemukan!")
            continue

        # Jika ada lebih dari satu menu yang cocok
        if len(hasil) > 1:
            print("\nDitemukan beberapa menu:")
            for nomor, menu in enumerate(hasil, start=1):
                print(f"{nomor}. {menu[1]} - Rp{menu[2]}")

            pilihan = int(input("Pilih nomor menu: "))

            if pilihan < 1 or pilihan > len(hasil):
                print("Pilihan tidak valid!")
                continue

            menu = hasil[pilihan - 1]

        else:
            menu = hasil[0]

        id_menu_pelangi = menu[0]
        nama_menu_pelangi = menu[1]
        harga = menu[2]
        stok = menu[3]

        print(f"\nMenu  : {nama_menu_pelangi}")
        print(f"Harga : Rp{harga}")
        print(f"Stok  : {stok}")

        jumlah = int(input("Masukkan jumlah: "))

        if jumlah <= 0:
            print("Jumlah harus lebih dari 0!")
            continue

        # Menghitung pesanan menu yang sama dalam transaksi ini
        jumlah_sebelumnya = sum(
            item[1] for item in daftar_pesanan
            if item[0] == id_menu_pelangi
        )

        if jumlah + jumlah_sebelumnya > stok:
            print("Stok tidak mencukupi!")
            continue

        subtotal = harga * jumlah
        total_harga += subtotal

        daftar_pesanan.append((id_menu_pelangi, jumlah, subtotal))

        print(f"Subtotal: Rp{subtotal}")

        tambah = input("\nTambah menu lain? (y/n): ").lower()

        if tambah != "y":
            break

    if len(daftar_pesanan) == 0:
        print("Belum ada menu yang dipesan!")
        input("\nTekan Enter untuk kembali...")
        return

    # Membuat ID pesanan otomatis
    sql = """
    SELECT id_pesanan_pelangi
    FROM pesanan_pelangi
    ORDER BY id_pesanan_pelangi DESC
    LIMIT 1
    """
    cursor.execute(sql)
    hasil = cursor.fetchone()

    if hasil is None:
        id_pesanan_pelangi = "PS001"
    else:
        nomor = int(hasil[0][2:]) + 1
        id_pesanan_pelangi = f"PS{nomor:03d}"

    total_jumlah = sum(item[1] for item in daftar_pesanan)
    
    print("\n===== PEMBAYARAN =====")
    print(f"Total Harga : Rp{total_harga:,}")

    while True:
        uang_masuk = int(input("Uang Masuk  : Rp"))

        if uang_masuk < total_harga:
            print("Uang tidak mencukupi! Silakan masukkan kembali.")
        else:
            break

    kembalian = uang_masuk - total_harga
    # Menyimpan transaksi utama
    sql = """
    INSERT INTO pesanan_pelangi
    (id_pesanan_pelangi, id_pelanggan_pelangi, jumlah_pelangi, total_harga_pelangi, status_pelangi, tanggal_pesanan_pelangi)
    VALUES (%s, %s, %s, %s, %s, NOW())
    """

    cursor.execute(sql, (
        id_pesanan_pelangi,
        id_pelanggan_pelangi,
        total_jumlah,
        total_harga,
        "Berhasil"
    ))

    # Menyimpan setiap menu ke detail pesanan
    for item in daftar_pesanan:
        id_menu_pelangi = item[0]
        jumlah = item[1]
        subtotal = item[2]

        sql = """
        INSERT INTO detail_pesanan_pelangi
        (id_pesanan_pelangi, id_menu_pelangi, jumlah_pelangi, subtotal_pelangi)
        VALUES (%s, %s, %s, %s)
        """

        cursor.execute(sql, (
            id_pesanan_pelangi,
            id_menu_pelangi,
            jumlah,
            subtotal
        ))

        # Mengurangi stok menu
        sql = """
        UPDATE menucafe_pelangi
        SET stok_pelangi = stok_pelangi - %s
        WHERE id_menu_pelangi = %s
        """

        cursor.execute(sql, (jumlah, id_menu_pelangi))

    koneksi.commit()

    print("\n===== PESANAN BERHASIL =====")
    print(f"ID Pesanan  : {id_pesanan_pelangi}")
    print(f"Total Menu  : {total_jumlah}")
    print(f"Total Harga : Rp{total_harga:,}")
    print(f"Uang Masuk  : Rp{uang_masuk:,}")
    print(f"Kembalian   : Rp{kembalian:,}")
    print("Status      : Berhasil")

    input("\nTekan Enter untuk kembali...")

def lihat_pesanan():
    os.system("clear")

    print("\n===== PESANAN SAYA =====")

    nama_pelanggan_pelangi = input("Ketik nama anda: ")

    # Mencari ID pelanggan berdasarkan nama
    sql = """
    SELECT id_pelanggan_pelangi
    FROM pelanggan_pelangi
    WHERE LOWER(nama_pelanggan_pelangi) = LOWER(%s)
    """
    cursor.execute(sql, (nama_pelanggan_pelangi,))
    pelanggan = cursor.fetchone()

    if pelanggan is None:
        print("\nPelanggan tidak ditemukan!")
        input("\nTekan Enter untuk kembali...")
        return

    id_pelanggan_pelangi = pelanggan[0]

    sql = """
    SELECT
        p.id_pesanan_pelangi,
        p.total_harga_pelangi,
        p.status_pelangi,
        p.tanggal_pesanan_pelangi,
        m.nama_menu_pelangi,
        d.jumlah_pelangi,
        d.subtotal_pelangi
    FROM pesanan_pelangi p
    JOIN detail_pesanan_pelangi d
        ON p.id_pesanan_pelangi = d.id_pesanan_pelangi
    JOIN menucafe_pelangi m
        ON d.id_menu_pelangi = m.id_menu_pelangi
    WHERE p.id_pelanggan_pelangi = %s
    ORDER BY p.tanggal_pesanan_pelangi DESC
    """

    cursor.execute(sql, (id_pelanggan_pelangi,))
    hasil = cursor.fetchall()

    if len(hasil) == 0:
        print("\nBelum ada pesanan.")

    else:
        id_sebelumnya = ""

        for row in hasil:
            if row[0] != id_sebelumnya:
                if id_sebelumnya != "":
                    print(f"\nTotal Harga : Rp{total_harga:,}")
                    print("-" * 40)

                id_sebelumnya = row[0]
                total_harga = row[1]

                print(f"\nID Pesanan  : {row[0]}")
                print(f"Tanggal     : {row[3]}")
                print(f"Status      : {row[2]}")
                print("\nDaftar Menu:")

            print(f"- {row[4]} x{row[5]} = Rp{row[6]:,}")

        print(f"\nTotal Harga : Rp{total_harga:,}")
        print("-" * 40)

    input("\nTekan Enter untuk kembali...")

def batalkan_pesanan():

    os.system("clear")

    print("\n===== HAPUS PESANAN =====")

    id_pesanan_pelangi = input("Masukkan ID pesanan: ")

    # Mengecek pesanan
    sql = """
    SELECT status_pelangi
    FROM pesanan_pelangi
    WHERE id_pesanan_pelangi = %s
    """

    cursor.execute(sql, (id_pesanan_pelangi,))
    hasil = cursor.fetchone()

    if hasil is None:
        print("\nPesanan tidak ditemukan!")

    else:
        konfirmasi = input("Yakin ingin menghapus pesanan? (y/n): ").lower()

        if konfirmasi == "y":

            # Mengambil detail menu
            sql = """
            SELECT id_menu_pelangi, jumlah_pelangi
            FROM detail_pesanan_pelangi
            WHERE id_pesanan_pelangi = %s
            """

            cursor.execute(sql, (id_pesanan_pelangi,))
            daftar_menu = cursor.fetchall()

            # Mengembalikan stok jika pesanan masih diproses
            if hasil[0] == "Diproses":
                for menu in daftar_menu:
                    sql = """
                    UPDATE menucafe_pelangi
                    SET stok_pelangi = stok_pelangi + %s
                    WHERE id_menu_pelangi = %s
                    """

                    cursor.execute(sql, (menu[1], menu[0]))

            # Menghapus detail pesanan terlebih dahulu
            sql = """
            DELETE FROM detail_pesanan_pelangi
            WHERE id_pesanan_pelangi = %s
            """

            cursor.execute(sql, (id_pesanan_pelangi,))

            # Menghapus pesanan utama
            sql = """
            DELETE FROM pesanan_pelangi
            WHERE id_pesanan_pelangi = %s
            """

            cursor.execute(sql, (id_pesanan_pelangi,))

            koneksi.commit()

            print("\nPesanan berhasil dihapus!")

        else:
            print("\nPenghapusan dibatalkan.")

    input("\nTekan Enter untuk kembali...")

def batalkan_pesanan_user():
    os.system("clear")

    print("\n===== BATALKAN PESANAN =====")

    nama_pelanggan_pelangi = input("Masukkan nama pelanggan: ")

    # Mencari ID pelanggan
    sql = """
    SELECT id_pelanggan_pelangi
    FROM pelanggan_pelangi
    WHERE LOWER(nama_pelanggan_pelangi) = LOWER(%s)
    """
    cursor.execute(sql, (nama_pelanggan_pelangi,))
    pelanggan = cursor.fetchone()

    if pelanggan is None:
        print("Pelanggan tidak ditemukan!")
        input("\nTekan Enter untuk kembali...")
        return

    id_pelanggan_pelangi = pelanggan[0]

    # Menampilkan pesanan yang berhasil
    sql = """
    SELECT id_pesanan_pelangi, total_harga_pelangi,
           tanggal_pesanan_pelangi
    FROM pesanan_pelangi
    WHERE id_pelanggan_pelangi = %s
    AND status_pelangi = 'Berhasil'
    """
    cursor.execute(sql, (id_pelanggan_pelangi,))
    hasil = cursor.fetchall()

    if len(hasil) == 0:
        print("\nTidak ada pesanan yang bisa dibatalkan.")
        input("\nTekan Enter untuk kembali...")
        return

    print("\n===== DAFTAR PESANAN =====")

    for row in hasil:
        print(f"\nID Pesanan  : {row[0]}")
        print(f"Total Harga : Rp{row[1]:,}")
        print(f"Tanggal     : {row[2]}")

    id_pesanan_pelangi = input("\nMasukkan ID pesanan yang ingin dibatalkan: ")

    # Memastikan pesanan milik pelanggan
    sql = """
    SELECT id_pesanan_pelangi
    FROM pesanan_pelangi
    WHERE id_pesanan_pelangi = %s
    AND id_pelanggan_pelangi = %s
    AND status_pelangi = 'Berhasil'
    """
    cursor.execute(sql, (id_pesanan_pelangi, id_pelanggan_pelangi))
    pesanan = cursor.fetchone()

    if pesanan is None:
        print("Pesanan tidak ditemukan atau sudah dibatalkan!")
        input("\nTekan Enter untuk kembali...")
        return

    konfirmasi = input("\nYakin ingin membatalkan pesanan? (y/n): ").lower()

    if konfirmasi != "y":
        print("Pembatalan dibatalkan.")
        input("\nTekan Enter untuk kembali...")
        return

    # Mengambil detail pesanan
    sql = """
    SELECT id_menu_pelangi, jumlah_pelangi
    FROM detail_pesanan_pelangi
    WHERE id_pesanan_pelangi = %s
    """
    cursor.execute(sql, (id_pesanan_pelangi,))
    detail = cursor.fetchall()

    # Mengembalikan stok menu
    for item in detail:
        sql = """
        UPDATE menucafe_pelangi
        SET stok_pelangi = stok_pelangi + %s
        WHERE id_menu_pelangi = %s
        """
        cursor.execute(sql, (item[1], item[0]))

    # Mengubah status pesanan
    sql = """
    UPDATE pesanan_pelangi
    SET status_pelangi = 'Dibatalkan'
    WHERE id_pesanan_pelangi = %s
    """
    cursor.execute(sql, (id_pesanan_pelangi,))

    koneksi.commit()

    print("\nPesanan berhasil dibatalkan!")
    print("Status : Dibatalkan")

    input("\nTekan Enter untuk kembali...")

