    if hasil is None:
        print("\nID pesanan tidak ditemukan!")
        input("\nTekan Enter untuk kembali...")
        return

    status = hasil[0]

    konfirmasi = input("\nYakin ingin menghapus pesanan? (y/n): ").lower()

    if konfirmasi == "y":

        # Mengambil detail pesanan
        sql = """
        SELECT id_menu_pelangi, jumlah_pelangi
        FROM detail_pesanan_pelangi
        WHERE id_pesanan_pelangi = %s
        """
        cursor.execute(sql, (id_pesanan_pelangi,))
        detail = cursor.fetchall()

        # Mengembalikan stok jika pesanan masih diproses
        if status == "Diproses":
            for item in detail:
                cursor.execute("""
                UPDATE menucafe_pelangi
                SET stok_pelangi = stok_pelangi + %s
                WHERE id_menu_pelangi = %s
