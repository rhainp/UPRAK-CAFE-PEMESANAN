    if pelanggan is None:
        print("Pelanggan tidak ditemukan!")
        input("\nTekan Enter untuk kembali...")
        return

    daftar_pesanan = []
    total_harga = 0

    while True:
        tampil_menu()

        nama_menu_pelangi = input("\nMasukkan nama menu: ")

        # Mencari menu tanpa memperhatikan huruf besar/kecil
        sql = """
        SELECT id_menu_pelangi, nama_menu_pelangi, harga_pelangi, stok_pelangi
        FROM menucafe_pelangi
        WHERE LOWER(nama_menu_pelangi) LIKE LOWER(%s)
        """

        cursor.execute(sql, ("%" + nama_menu_pelangi + "%",))
        hasil = cursor.fetchall()

        if len(hasil) == 0:
            print("Menu tidak ditemukan!")
            continue

        # Jika ada lebih dari satu menu yang cocok
        if len(hasil) > 1:
            print("\nDitemukan beberapa menu:")
            for nomor, menu in enumerate(hasil, start=1):
                print(f"{nomor}. {menu[1]} - Rp{menu[2]}")

            pilihan = int(input("Pilih nomor menu: "))

            if pilihan < 1 or pilihan > len(hasil):
                print("Pilihan tidak valid!")
                continue

            menu = hasil[pilihan - 1]

        else:
            menu = hasil[0]

        id_menu_pelangi = menu[0]
        nama_menu_pelangi = menu[1]
        harga = menu[2]
        stok = menu[3]

